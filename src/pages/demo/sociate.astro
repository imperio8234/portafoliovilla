---
import Layout from "~/layouts/Layout.astro";
---

<Layout title="Demo - Software Integral para Asociaciones Agrarias" pageTitle="Transforma tu Asociación">
  <main class="min-h-screen">
    <!-- Hero Section con Problema Principal -->
    <section class="bg-gradient-to-br from-red-600 via-orange-600 to-yellow-500 min-h-screen flex items-center relative overflow-hidden">
      <!-- Elementos decorativos flotantes -->
      <div class="absolute top-20 left-10 w-32 h-32 bg-white bg-opacity-10 rounded-full animate-bounce" style="animation-delay: 0s; animation-duration: 3s;"></div>
      <div class="absolute bottom-20 right-10 w-24 h-24 bg-white bg-opacity-10 rounded-full animate-bounce" style="animation-delay: 1s; animation-duration: 4s;"></div>
      <div class="absolute top-1/2 right-20 w-16 h-16 bg-white bg-opacity-10 rounded-full animate-pulse"></div>
      
      <div class="container mx-auto px-4 z-10 max-w-7xl">
       

        <div class="text-center text-white mb-12">
          <h1 class="text-4xl md:text-6xl lg:text-7xl font-black mb-6 leading-tight">
            ¿Tu Asociación Está 
            <span class="text-yellow-300 animate-pulse">Perdiendo Dinero y oportunidades</span>
            <br>por Falta de Control?
          </h1>
          
          <p class="text-lg md:text-xl lg:text-2xl text-orange-100 mb-8 max-w-4xl mx-auto leading-relaxed font-medium">
            <strong class="text-yellow-300">¡BASTA de pérdidas millonarias!</strong> La plataforma en Colombiana que combina 
            gestión completa de tu asociacion  + Agrónomo Virtual para los asociados con IA que podra reducir sus pedidas
          </p>
        </div>

        <!-- Problemas críticos - Grid -->
        <div class="grid md:grid-cols-2 gap-6 mb-12 max-w-4xl mx-auto">
          <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl border border-white/30 hover:bg-white/30 transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mr-4">
                <span class="text-2xl">💰</span>
              </div>
              <h3 class="text-xl font-bold text-white">Pérdidas Financieras</h3>
            </div>
            <ul class="text-orange-100 space-y-2 text-sm">
              <li>• Errores en pagos y recolecciones de productos de sus asociados</li>
              <li>• Errores en pagos por cálculos manuales</li>
              <li>• Pérdida de control en recaudos</li>
              <li>• Asociados desconfiados y molestos</li>
              <li>• Oportunidades comerciales perdidas</li>
            </ul>
          </div>

          <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl border border-white/30 hover:bg-white/30 transition-all duration-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-orange-500 rounded-full flex items-center justify-center mr-4">
                <span class="text-2xl">🐛</span>
              </div>
              <h3 class="text-xl font-bold text-white">Pérdidas de Cultivos</h3>
            </div>
            <ul class="text-orange-100 space-y-2 text-sm">
              <li>• <strong>40% de pérdidas por enfermedades tardías</strong></li>
              <li>• Tratamientos mal aplicados</li>
              <li>• Sin agrónomo disponible 24/7</li>
              <li>• Diagnósticos cuando ya es tarde</li>
            </ul>
          </div>
        </div>

        <!-- Call to Action Principal -->
        <div class="text-center">
          <div class="bg-white/10 backdrop-blur-sm p-8 rounded-3xl border border-white/30 max-w-2xl mx-auto">
            <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
              🚀 Ve la Solución en Acción
            </h2>
            <p class="text-orange-100 mb-6 text-lg">
              Descubre cómo otras asociaciones eliminaron sus pérdidas con nuestra demo personalizada
            </p>
            
            <div class="space-y-4">
              <button 
                id="btnDemoPersonalizada" 
                class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300 text-lg"
              >
                📞 Solicitar Demo Personalizada GRATIS
              </button>
              
              <button 
                id="btnPruebaRapida" 
                class="w-full bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white font-bold py-4 px-8 rounded-2xl shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300 text-lg border-2 border-white/30"
              >
                ⚡ Acceso Inmediato - Prueba 30 Días
              </button>
            </div>

            <div class="flex items-center justify-center mt-4 text-yellow-300 text-sm">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Sin compromiso • Configuración incluida • Soporte completo
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Solución -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4 max-w-7xl">
        <div class="text-center mb-16">
          <div class="inline-flex items-center bg-green-100 text-green-800 px-6 py-3 rounded-full text-sm font-bold mb-6">
            ✅ LA SOLUCIÓN QUE CAMBIA TODO
          </div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 mb-6">
            Convierte las Pérdidas en 
            <span class="text-green-600">Ganancias</span>
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            La única plataforma que <strong>ahorra hasta 30% en costos operativos</strong> 
            y evita pérdidas millonarias en cultivos
          </p>
        </div>

        <!-- Beneficios principales -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Beneficio 1 -->
          <div class="group p-8 rounded-3xl shadow-xl bg-gradient-to-br from-white to-gray-50 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-r from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <span class="text-3xl">💰</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Control Total de Pagos</h3>
            <p class="text-gray-600 mb-4">
              Elimina errores humanos, pagos incorrectos y desconfianza entre asociados
            </p>
            <div class="bg-green-50 p-3 rounded-lg border border-green-200">
              <p class="text-green-800 font-semibold text-sm">
                ✅ Ahorro promedio: $2-5 millones/mes
              </p>
            </div>
          </div>

          <!-- Beneficio 2 -->
          <div class="group p-8 rounded-3xl shadow-xl bg-gradient-to-br from-white to-gray-50 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-r from-green-500 to-green-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <span class="text-3xl">🤖</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Agrónomo IA 24/7</h3>
            <p class="text-gray-600 mb-4">
              Diagnóstico inmediato de enfermedades y tratamientos precisos
            </p>
            <div class="bg-green-50 p-3 rounded-lg border border-green-200">
              <p class="text-green-800 font-semibold text-sm">
                ✅ Reduce pérdidas de cultivos hasta 40%
              </p>
            </div>
          </div>

          <!-- Beneficio 3 -->
          <div class="group p-8 rounded-3xl shadow-xl bg-gradient-to-br from-white to-gray-50 hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-purple-600 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
              <span class="text-3xl">📊</span>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-4">gestion total de ventas y recolecciones de productos</h3>
            <p class="text-gray-600 mb-4">
              Reportes claros, trazabilidad y gestion de sus recolecciones
            </p>
            <div class="bg-green-50 p-3 rounded-lg border border-green-200">
              <p class="text-green-800 font-semibold text-sm">
                ✅ los asociados tendran mejor sus cuentas
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Urgencia -->
    <section class="py-20 bg-gradient-to-r from-red-500 to-orange-500 text-white">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black mb-6">
            ⏰ Cada Día que Esperas = Más Pérdidas
          </h2>
          <div class="grid md:grid-cols-3 gap-8 mb-12">
            <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl">
              <div class="text-4xl font-black text-yellow-300 mb-2">$500K+</div>
              <p class="text-lg">Pérdidas mensuales promedio sin control</p>
            </div>
            <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl">
              <div class="text-4xl font-black text-yellow-300 mb-2">40%</div>
              <p class="text-lg">De cultivos se pierden por diagnóstico tardío</p>
            </div>
            <div class="bg-white/20 backdrop-blur-sm p-6 rounded-2xl">
              <div class="text-4xl font-black text-yellow-300 mb-2">72h</div>
              <p class="text-lg">Para que una enfermedad sea irreversible</p>
            </div>
          </div>
          
          <div class="bg-white/10 backdrop-blur-sm p-8 rounded-3xl max-w-4xl mx-auto">
            <h3 class="text-2xl font-bold mb-4">🎯 Oferta Limitada - Primeras 10 Asociaciones</h3>
            <div class="text-lg space-y-2 mb-6">
              <p>✅ <strong>Prueba GRATIS por 30 días</strong></p>
              <p>✅ <strong>Configuración e implementación incluida</strong></p>
              <p>✅ <strong>Capacitación completa del equipo</strong></p>
              <p>✅ <strong>Soporte técnico prioritario</strong></p>
              <p class="text-yellow-300">🔥 <strong>Descuento del 40% el primer año</strong></p>
            </div>
            
            <!-- Contador de urgencia -->
            <div class="bg-red-600/30 p-4 rounded-xl mb-6">
              <p class="text-lg font-bold">⏳ Solo quedan <span class="text-yellow-300 text-2xl">7</span> cupos disponibles</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección de Contacto Mejorada -->
    <section class="py-20 bg-gray-900 text-white">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-black mb-6">
            🚀 Elige Tu Mejor Opción
          </h2>
          <p class="text-xl text-gray-300">
            Múltiples formas de comenzar a transformar tu asociación HOY
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- WhatsApp -->
          <div class="group bg-gradient-to-br from-white to-gray-100 p-8 rounded-3xl shadow-2xl text-center hover:scale-105 transition-all duration-300">
            <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-green-600 transition-colors">
              <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.382"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-4">WhatsApp Directo</h3>
            <p class="text-gray-600 mb-6">Respuesta inmediata de nuestro especialista</p>
            <button 
              id="btnWhatsApp" 
              class="w-full bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-2xl transition-all duration-300"
            >
              Chatear Ahora
            </button>
            <p class="text-xs text-gray-500 mt-2">Respuesta en menos de 2 minutos</p>
          </div>

          <!-- Llamada Telefónica -->
          <div class="group bg-gradient-to-br from-white to-gray-100 p-8 rounded-3xl shadow-2xl text-center hover:scale-105 transition-all duration-300">
            <div class="w-20 h-20 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-blue-600 transition-colors">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-4">Llamada Telefónica</h3>
            <p class="text-gray-600 mb-6">Demo personalizada por teléfono</p>
            <button 
              id="btnLlamar" 
              class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 px-6 rounded-2xl transition-all duration-300"
            >
              Llamar Ahora
            </button>
            <p class="text-xs text-gray-500 mt-2">+57 320 531 8658</p>
          </div>

          <!-- Formulario Rápido -->
          <div class="group bg-gradient-to-br from-white to-gray-100 p-8 rounded-3xl shadow-2xl text-center hover:scale-105 transition-all duration-300">
            <div class="w-20 h-20 bg-purple-500 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:bg-purple-600 transition-colors">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-gray-800 mb-4">Formulario Rápido</h3>
            <p class="text-gray-600 mb-6">Te contactamos en menos de 1 hora</p>
            <button 
              id="btnFormulario" 
              class="w-full bg-purple-500 hover:bg-purple-600 text-white font-bold py-3 px-6 rounded-2xl transition-all duration-300"
            >
              Llenar Formulario
            </button>
            <p class="text-xs text-gray-500 mt-2">Solo 2 minutos</p>
          </div>
        </div>

        <!-- Garantía y confianza -->
        <div class="mt-16 text-center">
          <div class="bg-gradient-to-r from-green-500/20 to-blue-500/20 backdrop-blur-sm p-8 rounded-3xl border border-green-500/30 max-w-4xl mx-auto">
            <h3 class="text-2xl font-bold mb-4">🛡️ Garantía de Satisfacción Total</h3>
            <div class="grid md:grid-cols-3 gap-6">
              <div class="text-center">
                <div class="text-3xl mb-2">💰</div>
                <p class="font-semibold">Devolución del 100%</p>
                <p class="text-sm text-gray-300">Si no ahorras dinero en 30 días</p>
              </div>
              <div class="text-center">
                <div class="text-3xl mb-2">🚀</div>
                <p class="font-semibold">Implementación Gratis</p>
                <p class="text-sm text-gray-300">Configuración completa incluida</p>
              </div>
              <div class="text-center">
                <div class="text-3xl mb-2">📞</div>
                <p class="font-semibold">Soporte 24/7</p>
                <p class="text-sm text-gray-300">Asistencia técnica permanente</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Formulario de contacto (Initially Hidden) -->
    <section id="formularioContacto" class="py-20 px-4 bg-gray-50 hidden">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">
            📝 Te Contactamos en Menos de 1 Hora
          </h2>
          <p class="text-xl text-gray-600">
            Déjanos tus datos y te llamamos para mostrarte exactamente cómo resolver los problemas de tu asociación
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl shadow-2xl">
          <form id="contactForm" class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="nombre" class="block text-sm font-bold text-gray-700 mb-2">
                  Nombre Completo *
                </label>
                <input 
                  type="text" 
                  id="nombre" 
                  name="nombre"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Tu nombre completo"
                />
              </div>
              
              <div>
                <label for="telefono" class="block text-sm font-bold text-gray-700 mb-2">
                  Teléfono/WhatsApp *
                </label>
                <input 
                  type="tel" 
                  id="telefono" 
                  name="telefono"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="300 123 4567"
                />
              </div>
              
              <div>
                <label for="asociacion" class="block text-sm font-bold text-gray-700 mb-2">
                  Nombre de la Asociación *
                </label>
                <input 
                  type="text" 
                  id="asociacion" 
                  name="asociacion"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Nombre de tu asociación"
                />
              </div>
              
              <div>
                <label for="municipio" class="block text-sm font-bold text-gray-700 mb-2">
                  Municipio *
                </label>
                <input 
                  type="text" 
                  id="municipio" 
                  name="municipio"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                  placeholder="Ciudad/Municipio"
                />
              </div>
              
              <div>
                <label for="productos" class="block text-sm font-bold text-gray-700 mb-2">
                  Productos Principales *
                </label>
                <select 
                  id="productos" 
                  name="productos"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                >
                  <option value="">Seleccionar producto</option>
                  <option value="cafe">Café</option>
                  <option value="cacao">Cacao</option>
                  <option value="panela">Panela</option>
                  <option value="frutas">Frutas</option>
                  <option value="hortalizas">Hortalizas</option>
                  <option value="lacteos">Lácteos</option>
                  <option value="mixto">Productos Mixtos</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
              
              <div>
                <label for="asociados" class="block text-sm font-bold text-gray-700 mb-2">
                  Número de Asociados *
                </label>
                <select 
                  id="asociados" 
                  name="asociados"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
                >
                  <option value="">Seleccionar rango</option>
                  <option value="1-25">1 - 25 asociados</option>
                  <option value="26-50">26 - 50 asociados</option>
                  <option value="51-100">51 - 100 asociados</option>
                  <option value="101-250">101 - 250 asociados</option>
                  <option value="250+">Más de 250 asociados</option>
                </select>
              </div>
            </div>
            
            <div>
              <label for="problemas" class="block text-sm font-bold text-gray-700 mb-2">
                ¿Cuál es tu mayor problema actual? *
              </label>
              <textarea 
                id="problemas" 
                name="problemas"
                required
                rows="3"
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 resize-none"
                placeholder="Describe brevemente cuál es el problema más urgente que enfrentas (ej: pérdidas por pagos incorrectos, enfermedades en cultivos, falta de control, etc.)"
              ></textarea>
            </div>
            
            <div>
              <label for="horario" class="block text-sm font-bold text-gray-700 mb-2">
                ¿Cuándo prefieres que te contactemos? *
              </label>
              <select 
                id="horario" 
                name="horario"
                required
                class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200"
              >
                <option value="">Seleccionar horario</option>
