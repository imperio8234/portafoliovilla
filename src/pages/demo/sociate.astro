  <!-- JavaScript -->
  <script>
    // Configuración
    const CONFIG = {
      whatsappNumber: "573205318658",
      phoneNumber: "+573205318658",
      companyEmail: "demo@tuempresa.com"
    } as const;

    // Mensajes predefinidos
    const MESSAGES = {
      whatsappDemo: encodeURIComponent(
        "🚨 ¡Hola! Vengo de la página web y NECESITO URGENTE una solución para mi asociación.\n\n" +
        "Estamos perdiendo dinero por:\n" +
        "• Errores en pagos y recaudos\n" +
        "• Falta de control en cultivos\n" +
        "• Problemas de transparencia\n\n" +
        "Quiero ver la DEMO PERSONALIZADA del software + Agrónomo IA que puede salvar nuestros cultivos.\n\n" +
        "¿Podemos agendar una demo HOY?"
      ),
      whatsappTrial: encodeURIComponent(
        "🚀 ¡Hola! Quiero acceso INMEDIATO a la prueba de 30 días del software para asociaciones.\n\n" +
        "He visto que pueden ayudarme con:\n" +
        "✅ Control automático de pagos\n" +
        "✅ Agrónomo Virtual con IA\n" +
        "✅ Gestión transparente\n\n" +
        "¿Cómo puedo empezar HOY mismo?"
      )
    } as const;

    // Event Listeners
    document.addEventListener('DOMContentLoaded', () => {
      // Elementos del DOM
      const btnDemoPersonalizada = document.getElementById('btnDemoPersonalizada') as HTMLButtonElement;
      const btnPruebaRapida = document.getElementById('btnPruebaRapida') as HTMLButtonElement;
      const btnWhatsApp = document.getElementById('btnWhatsApp') as HTMLButtonElement;
      const btnLlamar = document.getElementById('btnLlamar') as HTMLButtonElement;
      const btnFormulario = document.getElementById('btnFormulario') as HTMLButtonElement;
      const btnCerrarFormulario = document.getElementById('btnCerrarFormulario') as HTMLButtonElement;
      const formularioContacto = document.getElementById('formularioContacto') as HTMLElement;
      const contactForm = document.getElementById('contactForm') as HTMLFormElement;

      // Función para abrir WhatsApp
      const openWhatsApp = (message: string): void => {
        const url = `https://wa.me/${CONFIG.whatsappNumber}?text=${message}`;
        window.open(url, '_blank');
      };

      // Función para llamar por teléfono
      const makePhoneCall = (): void => {
        window.open(`tel:${CONFIG.phoneNumber}`, '_self');
      };

      // Función para mostrar formulario
      const showForm = (): void => {
        formularioContacto?.classList.remove('hidden');
        formularioContacto?.scrollIntoView({ 
          behavior: 'smooth',
          block: 'start'
        });
      };

      // Función para ocultar formulario
      const hideForm = (): void => {
        formularioContacto?.classList.add('hidden');
        window.scrollTo({ 
          top: 0, 
          behavior: 'smooth' 
        });
      };

      // Event Listeners - Botones principales
      btnDemoPersonalizada?.addEventListener('click', () => {
        openWhatsApp(MESSAGES.whatsappDemo);
      });

      btnPruebaRapida?.addEventListener('click', () => {
        openWhatsApp(MESSAGES.whatsappTrial);
      });

      // Event Listeners - Sección de contacto
      btnWhatsApp?.addEventListener('click', () => {
        openWhatsApp(MESSAGES.whatsappDemo);
      });

      btnLlamar?.addEventListener('click', () => {
        makePhoneCall();
      });

      btnFormulario?.addEventListener('click', () => {
        showForm();
      });

      btnCerrarFormulario?.addEventListener('click', () => {
        hideForm();
      });

      // Manejo del formulario de contacto
      contactForm?.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        
        const formData = new FormData(contactForm);
        const data: Record<string, string> = {};
        
        // Recopilar datos del formulario
        for (const [key, value] of formData.entries()) {
          data[key] = value.toString();
        }
        
        console.log('Datos del formulario:', data);
        
        // Crear mensaje para WhatsApp con los datos del formulario
        const whatsappFormMessage = encodeURIComponent(
          `🚨 FORMULARIO DE CONTACTO URGENTE\n\n` +
          `👤 Nombre: ${data.nombre}\n` +
          `📱 Teléfono: ${data.telefono}\n` +
          `🏢 Asociación: ${data.asociacion}\n` +
          `📍 Municipio: ${data.municipio}\n` +
          `🌱 Productos: ${data.productos}\n` +
          `👥 Asociados: ${data.asociados}\n` +
          `⚠️ Problema principal: ${data.problemas}\n` +
          `🕐 Horario preferido: ${data.horario}\n\n` +
          `Por favor contáctenme URGENTE para la demo personalizada.`
        );
        
        // Enviar por WhatsApp
        openWhatsApp(whatsappFormMessage);
        
        // Mostrar mensaje de éxito
        alert('¡Perfecto! Tu solicitud ha sido enviada por WhatsApp. Te contactaremos en menos de 1 hora.');
        
        // Opcional: resetear formulario
        contactForm.reset();
        
        // Opcional: ocultar formulario después de envío
        // hideForm();
      });

      // Animaciones y efectos adicionales
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-fade-in');
          }
        });
      }, observerOptions);

      // Observar elementos para animaciones
      document.querySelectorAll('.group').forEach(el => {
        observer.observe(el);
      });
    });

    // Función para tracking de eventos (opcional)
    const trackEvent = (action: string, category: string = 'Demo Page'): void => {
      // Aquí puedes agregar Google Analytics, Facebook Pixel, etc.
      console.log(`Event tracked: ${category} - ${action}`);
    };

    // CSS adicional para animaciones
    const style = document.createElement('style');
    style.textContent = `
      .animate-fade-in {
        animation: fadeIn 0.6s ease-in-out forwards;
      }
      
      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    `;
    document.head.appendChild(style);
  </script>
</Layout>