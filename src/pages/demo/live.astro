<script>
	// Configuración de contacto

    //@ts-nocheck
	const CONFIG = {
		whatsappNumber: "573205318658",
		phoneNumber: "+573205318658",
		companyEmail: "demo@tuempresa.com"
	} as const;

	// Mensajes predefinidos para WhatsApp
	const MESSAGES = {
		demoPersonal: encodeURIComponent(
			"🎥 ¡Hola! Vengo de la página de demos y quiero agendar una DEMOSTRACIÓN PERSONALIZADA del software para asociaciones.\n\n" +
			"He visto los videos y me interesa mucho:\n" +
			"📦 Control de recolecciones\n" +
			"💰 Gestión automática de pagos\n" +
			"🤖 Agrónomo IA funcional\n" +
			"📊 Dashboard ejecutivo\n\n" +
			"¿Cuándo podemos agendar una demo de 30 minutos para mi asociación?"
		),
		consultaDemo: encodeURIComponent(
			"📹 ¡Hola! He visto los demos en su página web y tengo algunas consultas específicas.\n\n" +
			"Me gustaría conocer más sobre:\n" +
			"• Precios y planes de pago\n" +
			"• Tiempo de implementación\n" +
			"• Capacitación incluida\n" +
			"• Soporte técnico\n\n" +
			"¿Podemos conversar sobre estos temas?"
		)
	} as const;

	// Función para abrir WhatsApp
	const openWhatsApp = (message: string): void => {
		const url = `https://wa.me/${CONFIG.whatsappNumber}?text=${message}`;
		window.open(url, '_blank');
	};

	// Event Listeners
	document.addEventListener('DOMContentLoaded', () => {
		// Botones de WhatsApp
		const btnContactoDemo = document.getElementById('btnContactoDemo');
		const btnDemoPersonal = document.getElementById('btnDemoPersonal');

		btnContactoDemo?.addEventListener('click', () => {
			openWhatsApp(MESSAGES.demoPersonal);
		});

		btnDemoPersonal?.addEventListener('click', () => {
			openWhatsApp(MESSAGES.demoPersonal);
		});

		// Simulación de reproducción de videos
		const videoPlaceholders = document.querySelectorAll('.group.cursor-pointer');
		
		videoPlaceholders.forEach((placeholder) => {
			placeholder.addEventListener('click', function() {
				// Efecto visual de clic
				this.style.transform = 'scale(0.95)';
				setTimeout(() => {
					this.style.transform = '';
				}, 150);

				// Simular apertura de video (aquí integrarías con tu sistema de videos real)
				const videoTitle = this.querySelector('p.font-medium')?.textContent || 'Video demo';
				
				// Mostrar modal o redirigir a reproductor
				showVideoModal(videoTitle);
			});
		});

		// Smooth scroll para navegación interna
		document.querySelectorAll('a[href^="#"]').forEach(anchor => {
			anchor.addEventListener('click', function (e) {
				e.preventDefault();
				const targetId = this.getAttribute('href')?.substring(1);
				const targetElement = targetId ? document.getElementById(targetId) : null;
				
				if (targetElement) {
					targetElement.scrollIntoView({
						behavior: 'smooth',
						block: 'start'
					});
				}
			});
		});

		// Animaciones de entrada para elementos
		const observerOptions = {
			threshold: 0.1,
			rootMargin: '0px 0px -50px 0px'
		};

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					entry.target.style.opacity = '1';
					entry.target.style.transform = 'translateY(0)';
				}
			});
		}, observerOptions);

		// Inicializar animaciones
		document.querySelectorAll('.bg-white.rounded-xl').forEach((card) => {
			card.style.opacity = '0';
			card.style.transform = 'translateY(30px)';
			card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
			observer.observe(card);
		});

		// Efectos hover mejorados para tarjetas de demo
		document.querySelectorAll('.hover\\:shadow-xl').forEach((card) => {
			card.addEventListener('mouseenter', function() {
				this.style.transform = 'translateY(-5px)';
				this.style.transition = 'all 0.3s ease';
			});
			
			card.addEventListener('mouseleave', function() {
                //@ts-ignore
				this.style.transform = 'translateY(0)';
			});
		});
	});

	// Función para mostrar modal de video (placeholder)
	function showVideoModal(videoTitle: string) {
		// Crear modal dinámico
		const modal = document.createElement('div');
		modal.className = 'fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center p-4';
		modal.innerHTML = `
			<div class="bg-white rounded-xl max-w-4xl w-full max-h-full overflow-auto">
				<div class="p-6">
					<div class="flex justify-between items-center mb-4">
						<h3 class="text-xl font-bold text-gray-900">${videoTitle}</h3>
						<button id="closeModal" class="text-gray-500 hover:text-gray-700 text-2xl">&times;</button>
					</div>
					<div class="bg-gray-900 rounded-lg h-96 flex items-center justify-center">
						<div class="text-center text-white">
							<div class="text-6xl mb-4">📹</div>
							<p class="text-xl mb-2">Demo Video</p>
							<p class="text-gray-300">Aquí se reproduciría el video real del demo</p>
							<div class="mt-6">
								<button id="requestPersonalDemo" class="bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700">
									Solicitar Demo Personal
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		`;

		document.body.appendChild(modal);

		// Event listeners del modal
		const closeModal = modal.querySelector('#closeModal');
		const requestDemo = modal.querySelector('#requestPersonalDemo');

		closeModal?.addEventListener('click', () => {
			document.body.removeChild(modal);
		});

		requestDemo?.addEventListener('click', () => {
			openWhatsApp(MESSAGES.demoPersonal);
			document.body.removeChild(modal);
		});

		// Cerrar modal al hacer clic fuera
		modal.addEventListener('click', (e) => {
			if (e.target === modal) {
				document.body.removeChild(modal);
			}
		});

		// Cerrar modal con ESC
		const handleEscKey = (e: KeyboardEvent) => {
			if (e.key === 'Escape') {
				document.body.removeChild(modal);
				document.removeEventListener('keydown', handleEscKey);
			}
		};
		document.addEventListener('keydown', handleEscKey);
	}

	// Función para trackear interacciones (opcional - para analytics)
	function trackDemoInteraction(action: string, demoType: string) {
		// Aquí puedes integrar con Google Analytics, Mixpanel, etc.
		console.log(`Demo interaction: ${action} - ${demoType}`);
	}
</script>

