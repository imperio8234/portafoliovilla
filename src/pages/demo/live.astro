---
// src/pages/demo/videos.astro
//@ts-nocheck
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Hero from "~/components/Hero.astro";
import Heading from "~/components/Heading.astro";

// Imágenes de fondo agrícolas
import ImageVideoBackground from "~/assets/images/image2.png";
---

<Layout
	pageTitle="Demos en Vivo - Software para Asociaciones Agrícolas"
	title="Demos en Vivo del Software Agrícola"
	description="Mira cómo funciona nuestro software para asociaciones agrícolas en demos reales. Control de recolecciones, pagos automáticos y Agrónomo IA en acción."
>
	{/* Hero Section con fondo agrícola */}
	<Section class="relative bg-gradient-to-br from-green-800 via-green-700 to-green-600">
		<Image
			src={ImageVideoBackground}
			alt="Demo software agrícola"
			class="absolute inset-0 w-full h-full object-cover opacity-20"
		/>
		<div class="absolute inset-0 bg-green-800/70"></div>
		
		<Container class="relative z-10">
			<Hero>
				<div slot="hero-left" class="space-y-8">
					<div class="space-y-4">
						<div class="inline-flex items-center bg-yellow-500/20 backdrop-blur rounded-full px-6 py-3 text-yellow-300 border border-yellow-400/30">
							<span class="animate-pulse mr-2">🎥</span>
							<span class="font-bold">DEMOS EN VIVO DISPONIBLES</span>
						</div>
						
						<h1 class="text-4xl lg:text-6xl font-bold text-white leading-tight">
							Ve el Software
							<span class="text-yellow-400">en Acción Real</span>
						</h1>
						
						<p class="text-xl text-green-100 max-w-2xl">
							Descubre cómo asociaciones reales están transformando su gestión 
							con nuestro software. Cada demo muestra resultados concretos y funcionalidades operativas.
						</p>
					</div>

					{/* Stats rápidas */}
					<div class="grid grid-cols-3 gap-4">
						<div class="bg-white/10 backdrop-blur rounded-lg p-4 text-center">
							<div class="text-2xl font-bold text-yellow-400">12</div>
							<div class="text-sm text-green-100">Demos Disponibles</div>
						</div>
						<div class="bg-white/10 backdrop-blur rounded-lg p-4 text-center">
							<div class="text-2xl font-bold text-yellow-400">4</div>
							<div class="text-sm text-green-100">Módulos Principales</div>
						</div>
						<div class="bg-white/10 backdrop-blur rounded-lg p-4 text-center">
							<div class="text-2xl font-bold text-yellow-400">100%</div>
							<div class="text-sm text-green-100">Funcional</div>
						</div>
					</div>

					{/* CTA Principal */}
					<div class="flex flex-col sm:flex-row gap-4">
						<button
							id="btnContactoDemo"
							class="bg-yellow-500 text-green-800 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transform hover:scale-105 transition-all shadow-lg"
						>
							📱 Solicitar Demo Personal
						</button>
						<Button
							href="#demos-disponibles"
							class="border-2 border-white text-white px-8 py-4 rounded-lg font-medium hover:bg-white hover:text-green-800 transition-colors"
						>
							Ver Demos Ahora
						</Button>
					</div>
				</div>

				<div slot="hero-right" class="hidden lg:block">
					<div class="bg-white/10 backdrop-blur rounded-2xl p-8 shadow-2xl">
						<div class="text-center mb-6">
							<div class="text-6xl mb-4">📹🏢</div>
							<h3 class="text-xl font-bold text-white">Videos Reales</h3>
							<p class="text-green-100 text-sm">Con casos de uso específicos</p>
						</div>
						<div class="space-y-3">
							<div class="bg-green-500/20 rounded-lg p-3 text-center">
								<div class="text-sm text-white">🚀 Implementación completa</div>
							</div>
							<div class="bg-blue-500/20 rounded-lg p-3 text-center">
								<div class="text-sm text-white">📊 Resultados medibles</div>
							</div>
							<div class="bg-yellow-500/20 rounded-lg p-3 text-center">
								<div class="text-sm text-white">🤖 IA funcionando</div>
							</div>
						</div>
					</div>
				</div>
			</Hero>
		</Container>
	</Section>

	{/* Sección de Demos Principales */}
	<Section id="demos-disponibles" class="py-16 bg-white">
		<Container>
			<Heading class="text-center mx-auto mb-12">
				<h2 slot="heading-title">
					Demos por Módulo del Software
				</h2>
				<p slot="heading-content">
					Cada video muestra el funcionamiento real del software con datos de asociaciones reales
				</p>
			</Heading>

			<div class="grid lg:grid-cols-2 gap-12">
				{/* Demo 1: Control de Recolecciones */}
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow">
					<div class="bg-gradient-to-r from-blue-600 to-blue-700 p-6">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
								<span class="text-2xl">📦</span>
							</div>
							<div>
								<h3 class="text-xl font-bold text-white">Control de Recolecciones</h3>
								<p class="text-blue-100">Registro automático y trazabilidad</p>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						{/* Placeholder para video */}
						<div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center mb-4 relative group cursor-pointer">
							<div class="text-center">
								<div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
									<span class="text-white text-2xl">▶️</span>
								</div>
								<p class="text-gray-600 font-medium">Ver Demo: Registro de Café</p>
								<p class="text-gray-500 text-sm">Duración: 3:45 min</p>
							</div>
							<div class="absolute inset-0 bg-blue-600/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg"></div>
						</div>

						<div class="space-y-3">
							<h4 class="font-semibold text-gray-900">Lo que verás en este demo:</h4>
							<ul class="text-gray-700 space-y-2 text-sm">
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Proceso completo de registro de 500kg de café</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Generación automática de códigos QR</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Control de calidad y clasificación</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Actualización automática de inventarios</span>
								</li>
							</ul>
						</div>

						<div class="mt-6 p-4 bg-blue-50 rounded-lg">
							<div class="flex items-center text-blue-800">
								<span class="text-xl mr-2">💡</span>
								<span class="font-medium">Caso real: COOPCAFÉ redujo pérdidas en 90%</span>
							</div>
						</div>
					</div>
				</div>

				{/* Demo 2: Gestión de Pagos */}
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow">
					<div class="bg-gradient-to-r from-yellow-600 to-orange-600 p-6">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
								<span class="text-2xl">💰</span>
							</div>
							<div>
								<h3 class="text-xl font-bold text-white">Gestión de Pagos</h3>
								<p class="text-yellow-100">Cálculos automáticos y transparencia</p>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center mb-4 relative group cursor-pointer">
							<div class="text-center">
								<div class="w-16 h-16 bg-yellow-600 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
									<span class="text-white text-2xl">▶️</span>
								</div>
								<p class="text-gray-600 font-medium">Ver Demo: Liquidación Semanal</p>
								<p class="text-gray-500 text-sm">Duración: 5:20 min</p>
							</div>
							<div class="absolute inset-0 bg-yellow-600/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg"></div>
						</div>

						<div class="space-y-3">
							<h4 class="font-semibold text-gray-900">Lo que verás en este demo:</h4>
							<ul class="text-gray-700 space-y-2 text-sm">
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Cálculo automático de 47 asociados</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Descuentos y anticipos aplicados</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Generación de recibos digitales</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Notificación automática por WhatsApp</span>
								</li>
							</ul>
						</div>

						<div class="mt-6 p-4 bg-yellow-50 rounded-lg">
							<div class="flex items-center text-yellow-800">
								<span class="text-xl mr-2">⚡</span>
								<span class="font-medium">Tiempo de liquidación: 10 minutos (antes 2 días)</span>
							</div>
						</div>
					</div>
				</div>

				{/* Demo 3: Agrónomo IA */}
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow">
					<div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-6">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
								<span class="text-2xl">🤖</span>
							</div>
							<div>
								<h3 class="text-xl font-bold text-white">Agrónomo IA en Acción</h3>
								<p class="text-purple-100">Diagnósticos reales y tratamientos</p>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center mb-4 relative group cursor-pointer">
							<div class="text-center">
								<div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
									<span class="text-white text-2xl">▶️</span>
								</div>
								<p class="text-gray-600 font-medium">Ver Demo: Diagnóstico de Roya</p>
								<p class="text-gray-500 text-sm">Duración: 4:15 min</p>
							</div>
							<div class="absolute inset-0 bg-purple-600/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg"></div>
						</div>

						<div class="space-y-3">
							<h4 class="font-semibold text-gray-900">Lo que verás en este demo:</h4>
							<ul class="text-gray-700 space-y-2 text-sm">
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Consulta real sobre manchas en hojas</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Análisis de imagen con IA</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Diagnóstico: Roya del café (Hemileia)</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Plan de tratamiento personalizado</span>
								</li>
							</ul>
						</div>

						<div class="mt-6 p-4 bg-purple-50 rounded-lg">
							<div class="flex items-center text-purple-800">
								<span class="text-xl mr-2">💡</span>
								<span class="font-medium">Resultado: Pérdida evitada de $500,000</span>
							</div>
						</div>
					</div>
				</div>

				{/* Demo 4: Dashboard Integral */}
				<div class="bg-white rounded-xl shadow-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-shadow">
					<div class="bg-gradient-to-r from-green-600 to-teal-600 p-6">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center mr-4">
								<span class="text-2xl">📊</span>
							</div>
							<div>
								<h3 class="text-xl font-bold text-white">Dashboard Ejecutivo</h3>
								<p class="text-green-100">Vista completa de la asociación</p>
							</div>
						</div>
					</div>
					
					<div class="p-6">
						<div class="bg-gray-100 rounded-lg h-48 flex items-center justify-center mb-4 relative group cursor-pointer">
							<div class="text-center">
								<div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:scale-110 transition-transform">
									<span class="text-white text-2xl">▶️</span>
								</div>
								<p class="text-gray-600 font-medium">Ver Demo: Reporte Mensual</p>
								<p class="text-gray-500 text-sm">Duración: 6:30 min</p>
							</div>
							<div class="absolute inset-0 bg-green-600/10 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg"></div>
						</div>

						<div class="space-y-3">
							<h4 class="font-semibold text-gray-900">Lo que verás en este demo:</h4>
							<ul class="text-gray-700 space-y-2 text-sm">
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Métricas de producción en tiempo real</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Estado financiero de la asociación</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Análisis de productividad por asociado</span>
								</li>
								<li class="flex items-start">
									<span class="text-green-500 mr-2 mt-0.5">✓</span>
									<span>Proyecciones de cosecha</span>
								</li>
							</ul>
						</div>

						<div class="mt-6 p-4 bg-green-50 rounded-lg">
							<div class="flex items-center text-green-800">
								<span class="text-xl mr-2">📈</span>
								<span class="font-medium">Mejora en toma de decisiones: 85%</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	{/* Sección de Casos de Éxito */}
	<Section class="py-16 bg-gray-50">
		<Container>
			<Heading class="text-center mx-auto mb-12">
				<h2 slot="heading-title">
					Casos de Éxito Documentados
				</h2>
				<p slot="heading-content">
					Mira testimonios reales de asociaciones que ya implementaron el software
				</p>
			</Heading>

			<div class="grid md:grid-cols-2 gap-8">
				{/* Caso 1 */}
				<div class="bg-white rounded-xl p-8 shadow-lg">
					<div class="flex items-center mb-6">
						<div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mr-4">
							<span class="text-2xl">🏢</span>
						</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900">ASOCAFÉ Chinchiná</h3>
							<p class="text-gray-600">127 asociados • Café especialidad</p>
						</div>
					</div>

					<div class="bg-gray-100 rounded-lg h-32 flex items-center justify-center mb-6 relative group cursor-pointer">
						<div class="text-center">
							<div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
								<span class="text-white text-lg">▶️</span>
							</div>
							<p class="text-gray-600 font-medium text-sm">Testimonio: 8 meses de uso</p>
						</div>
					</div>

					<blockquote class="text-gray-700 italic mb-4">
						"Antes tardábamos 3 días calculando pagos. Ahora son 15 minutos. 
						El Agrónomo IA nos ayudó a detectar roya temprana y evitamos pérdidas de $15 millones."
					</blockquote>

					<div class="text-right">
						<div class="text-green-700 font-semibold">María González</div>
						<div class="text-gray-500 text-sm">Gerente ASOCAFÉ</div>
					</div>

					<div class="mt-6 grid grid-cols-3 gap-4 text-center">
						<div>
							<div class="text-2xl font-bold text-green-600">90%</div>
							<div class="text-xs text-gray-500">Menos errores</div>
						</div>
						<div>
							<div class="text-2xl font-bold text-green-600">$15M</div>
							<div class="text-xs text-gray-500">Pérdidas evitadas</div>
						</div>
						<div>
							<div class="text-2xl font-bold text-green-600">15min</div>
							<div class="text-xs text-gray-500">Tiempo pagos</div>
						</div>
					</div>
				</div>

				{/* Caso 2 */}
				<div class="bg-white rounded-xl p-8 shadow-lg">
					<div class="flex items-center mb-6">
						<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mr-4">
							<span class="text-2xl">🌱</span>
						</div>
						<div>
							<h3 class="text-xl font-bold text-gray-900">COOPCACAO Pereira</h3>
							<p class="text-gray-600">89 asociados • Cacao orgánico</p>
						</div>
					</div>

					<div class="bg-gray-100 rounded-lg h-32 flex items-center justify-center mb-6 relative group cursor-pointer">
						<div class="text-center">
							<div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-2 group-hover:scale-110 transition-transform">
								<span class="text-white text-lg">▶️</span>
							</div>
							<p class="text-gray-600 font-medium text-sm">Testimonio: 5 meses de uso</p>
						</div>
					</div>

					<blockquote class="text-gray-700 italic mb-4">
						"El control de recolección nos permitió tener trazabilidad completa. 
						Ahora vendemos directo a exportadores por nuestra transparencia."
					</blockquote>

					<div class="text-right">
						<div class="text-blue-700 font-semibold">Carlos Ramírez</div>
						<div class="text-gray-500 text-sm">Presidente COOPCACAO</div>
					</div>

					<div class="mt-6 grid grid-cols-3 gap-4 text-center">
						<div>
							<div class="text-2xl font-bold text-blue-600">30%</div>
							<div class="text-xs text-gray-500">Mejor precio</div>
						</div>
						<div>
							<div class="text-2xl font-bold text-blue-600">100%</div>
							<div class="text-xs text-gray-500">Trazabilidad</div>
						</div>
						<div>
							<div class="text-2xl font-bold text-blue-600">24/7</div>
							<div class="text-xs text-gray-500">Soporte IA</div>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	{/* Call to Action Final */}
	<Section class="py-16 bg-gradient-to-br from-green-800 to-green-900 text-white">
		<Container>
			<div class="text-center max-w-4xl mx-auto">
				<h2 class="text-3xl lg:text-4xl font-bold mb-6">
					¿Listo para Ver una Demo Personalizada?
				</h2>
				<p class="text-xl text-green-100 mb-8">
					Agenda una sesión en vivo donde te mostramos el software funcionando 
					específicamente para tu tipo de asociación y cultivos.
				</p>

				<div class="bg-white/10 backdrop-blur rounded-2xl p-8 mb-8">
					<h3 class="text-xl font-bold mb-4">En tu demo personalizada verás:</h3>
					<div class="grid md:grid-cols-2 gap-4 text-left">
						<div class="flex items-start space-x-3">
							<span class="text-yellow-400 text-xl">✓</span>
							<span>Configuración específica para tu cultivo</span>
						</div>
						<div class="flex items-start space-x-3">
							<span class="text-yellow-400 text-xl">✓</span>
							<span>Cálculo de ROI para tu asociación</span>
						</div>
						<div class="flex items-start space-x-3">
							<span class="text-yellow-400 text-xl">✓</span>
							<span>Plan de implementación paso a paso</span>
						</div>
						<div class="flex items-start space-x-3">
							<span class="text-yellow-400 text-xl">✓</span>
							<span>Precios y planes de pago flexibles</span>
						</div>
					</div>
				</div>

				<div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-6">
					<button
						id="btnDemoPersonal"
						class="bg-yellow-500 text-green-800 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transform hover:scale-105 transition-all shadow-lg"
					>
						📅 Agendar Demo Personal
					</button>
					<Button
						href="#demos-disponibles"
						class="border-2 border-white text-white px-8 py-4 rounded-lg font-medium hover:bg-white hover:text-green-800 transition-colors"
					>
						Ver Más Videos
					</Button>
				</div>

				<div class="text-sm text-green-200">
					✅ Demo gratuita de 30 minutos • ✅ Sin compromiso • ✅ Asesoría incluida
				</div>

				<div class="mt-8 bg-red-500/20 border border-red-400/30 rounded-lg p-4 max-w-2xl mx-auto">
					<p class="text-sm font-medium">
						⚡ OFERTA ESPECIAL: Las primeras 5 asociaciones que agenden demo 
						esta semana reciben 50% de descuento en el primer año
					</p>
