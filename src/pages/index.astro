---
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Hero from "~/components/Hero.astro";
import Faq from "~/components/Faq.astro";
import Heading from "~/components/Heading.astro";
import WidgetSearch from "~/components/WidgetSearch.astro";
import Grid from "~/components/Grid.astro";
import GridItem from "~/components/GridItem.astro";
import ShowPosts from "~/components/ShowPosts.astro";
import Team from "~/components/Team.astro";
import Stats from "~/components/Stats.astro";

// Images
import ImageSoftwareMain from "~/assets/images/image3.png";
import ImageHeadingBackground from "~/assets/images/image2.png";
import ShowFeatures from "~/components/ShowFeatures.astro";
import ImageAutomation from "~/assets/images/pexels-leif-bergerson-99376750-9764731.webp";
import ImageAnalytics from "~/assets/images/pexels-zenzazione-2922140.webp";

// Nuevas imágenes para añadir
import ImageAsociadosPagando from "~/assets/images/pagando.webp";
import ImageCultivoPerdido from "~/assets/images/cultivoperdido.webp";
import ImageAsociadosReunidos from "~/assets/images/reunion.webp";
import ImageAsociadosEnojados from "~/assets/images/asociados-enojados.webp";
import ImageRecoleccion from "~/assets/images/asociadosrecolectando.webp";

// src/pages/index.astro
---

<Layout
	pageTitle="Software para Asociaciones Agrarias y Automatización con IA"
	title="Software para asociaciones y servicios de automatizaciones con ia"
	description="Software especializado para asociaciones agrícolas que controla recolección de productos, pagos a productores, contabilidad y recaudos. Incluye Asistente Agrónomo IA funcional para diagnósticos y tratamientos."
>
	{/* Main Heading */}
	<Section class:list={"relative"}>
		<Image
			src={ImageHeadingBackground}
			alt="Software asociativo background"
			class:list={"absolute inset-0 w-full h-full object-cover"}
		/>
		<div
			class="absolute inset-0 w-full h-full object-cover bg-green-800/85"
		>
		</div>
		<Container class:list={"relative z-10"}>
			<Hero>
				<div slot="hero-left" class="relative z-10 space-y-8">
					<!-- Main Heading -->
					<div class="space-y-4">
						<h1
							class="text-4xl lg:text-6xl font-bold leading-tight"
						>
							Gestión Integral para
							<span class="text-yellow-400"
								>Asociaciones Agrícolas</span
							>
						</h1>
						<p
							class="text-xl lg:text-2xl text-green-100 font-light"
						>
							Automatiza recolecciones, pagos de asociados gastos
							de tu asociacion, ademas asistencia técnica para
							cada asociado en una sola plataforma
						</p>
					</div>

					<!-- Key Problems Stats -->
					<div class="grid grid-cols-2 gap-4">
						<div
							class="bg-white/10 backdrop-blur rounded-lg p-4 text-center"
						>
							<div class="text-2xl font-bold text-red-300">
								40%
							</div>
							<div class="text-sm text-green-100">
								Evita Pérdidas por diagnósticos tardíos
							</div>
						</div>
						<div
							class="bg-white/10 backdrop-blur rounded-lg p-4 text-center"
						>
							<div class="text-2xl font-bold text-orange-300">
								30%
							</div>
							<div class="text-sm text-green-100">
								Aumenta Ineficiencias por gestión manual
							</div>
						</div>
					</div>

					<!-- CTA Buttons -->
					<div class="flex flex-col sm:flex-row gap-4">
						<Button
							href="/demo/sociate"
							class:list={"bg-yellow-500 text-green-800 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transform hover:scale-105 transition-all shadow-lg"}
						>
							🎯 PRUEBA GRATIS 30 DÍAS
						</Button>
						<Button
							href="/demo/live"
							class:list={"border-2 border-white text-white px-8 py-4 rounded-lg font-medium hover:bg-white hover:text-green-800 transition-colors"}
						>
							Ver Demo en Vivo
						</Button>
					</div>

					<!-- Trust Indicators -->
					<div class="text-sm text-green-100">
						✅ Sin compromiso • ✅ Capacitación incluida • ✅
						Soporte personalizado
					</div>
				</div>

				<div slot="hero-right" class="hidden lg:block relative z-10">
					<div
						class="bg-white/10 backdrop-blur rounded-2xl p-8 shadow-2xl"
					>
						<div class="text-center mb-6">
							<div class="text-6xl mb-4">🏢📊</div>
							<h3 class="text-xl font-bold text-white">
								Plataforma Todo-en-Uno
							</h3>
						</div>
						<div class="grid grid-cols-3 gap-4">
							<div
								class="bg-blue-500/20 rounded-lg p-4 text-center"
							>
								<div class="text-2xl mb-2">📦</div>
								<div class="text-xs">Recolecciones</div>
							</div>
							<div
								class="bg-yellow-500/20 rounded-lg p-4 text-center"
							>
								<div class="text-2xl mb-2">💰</div>
								<div class="text-xs">Pagos</div>
							</div>
							<div
								class="bg-purple-500/20 rounded-lg p-4 text-center"
							>
								<div class="text-2xl mb-2">👨‍🌾</div>
								<div class="text-xs">Asistencia IA</div>
							</div>
						</div>
					</div>
				</div>
			</Hero>
		</Container>
	</Section>

	<!-- Problems Section -->
	<Section class="py-16 bg-white">
		<Container>
			<div class="text-center mb-16">
				<h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
					Los Desafíos que Enfrentas Diariamente
				</h2>
				<p class="text-xl text-gray-600">
					La gestión manual está limitando el crecimiento de tu
					asociación
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-8">
				<!-- Gestión de Recolecciones -->
				<div
					class="bg-red-50 border-l-4 border-red-500 rounded-r-lg p-6 h-full"
				>
					<div class="flex items-center mb-4">
						<div class="text-3xl mr-3">📊</div>
						<h3 class="text-red-800 font-bold text-lg">
							Recolecciones Caóticas
						</h3>
					</div>
					<ul class="text-red-700 space-y-3">
						<li class="flex items-start">
							<span class="text-red-500 mr-2">✗</span>
							<span class="text-sm"
								>Sin control de entregas ni calidad</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-red-500 mr-2">✗</span>
							<span class="text-sm"
								>Pérdida total de trazabilidad</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-red-500 mr-2">✗</span>
							<span class="text-sm"
								>Imposible planificar volúmenes</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-red-500 mr-2">✗</span>
							<span class="text-sm"
								>Inventarios confusos y conflictos</span
							>
						</li>
					</ul>
				</div>

				<!-- Pagos y Recaudos -->
				<div
					class="bg-orange-50 border-l-4 border-orange-500 rounded-r-lg p-6 h-full"
				>
					<div class="flex items-center mb-4">
						<div class="text-3xl mr-3">💳</div>
						<h3 class="text-orange-800 font-bold text-lg">
							Pagos Desorganizados
						</h3>
					</div>
					<ul class="text-orange-700 space-y-3">
						<li class="flex items-start">
							<span class="text-orange-500 mr-2">✗</span>
							<span class="text-sm"
								>Cálculos manuales erróneos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-orange-500 mr-2">✗</span>
							<span class="text-sm"
								>Sin control de recaudos ni saldos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-orange-500 mr-2">✗</span>
							<span class="text-sm">Falta historial de pagos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-orange-500 mr-2">✗</span>
							<span class="text-sm"
								>Flujo de caja comprometido</span
							>
						</li>
					</ul>
				</div>

				<!-- Asistencia Técnica -->
				<div
					class="bg-purple-50 border-l-4 border-purple-500 rounded-r-lg p-6 h-full"
				>
					<div class="flex items-center mb-4">
						<div class="text-3xl mr-3">👨‍🌾</div>
						<h3 class="text-purple-800 font-bold text-lg">
							Asistencia Insuficiente
						</h3>
					</div>
					<ul class="text-purple-700 space-y-3">
						<li class="flex items-start">
							<span class="text-purple-500 mr-2">✗</span>
							<span class="text-sm"
								>Agrónomo no siempre disponible</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-purple-500 mr-2">✗</span>
							<span class="text-sm"
								>Diagnósticos tardíos y costosos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-purple-500 mr-2">✗</span>
							<span class="text-sm"
								>Sin seguimiento de tratamientos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-purple-500 mr-2">✗</span>
							<span class="text-sm">Conocimiento fragmentado</span
							>
						</li>
					</ul>
					<div class="mt-4 p-3 bg-purple-100 rounded-md">
						<p
							class="text-purple-800 font-bold text-sm text-center"
						>
							📊 40% Evita de pérdidas por diagnósticos tardíos
						</p>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<!-- Solution Section -->
	<Section class="py-16 bg-gray-50">
		<Container>
			<div class="text-center mb-16">
				<div
					class="inline-block bg-green-100 text-green-800 px-6 py-2 rounded-full font-medium mb-4"
				>
					🌟 Solución Integral
				</div>
				<h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
					La Única Plataforma que Necesita tu Asociación
				</h2>
				<p class="text-xl text-gray-600">
					Gestión completa + Asistencia técnica con IA disponible 24/7
				</p>
			</div>

			<div class="grid lg:grid-cols-3 gap-8">
				<!-- Recolecciones Module -->
				<div
					class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow"
				>
					<div class="text-center mb-6">
						<div
							class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
						>
							<span class="text-3xl">📦</span>
						</div>
						<h3 class="text-xl font-bold text-gray-900">
							Control Total de Recolecciones
						</h3>
					</div>
					<ul class="space-y-3">
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Registro con datos completos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Trazabilidad desde origen hasta venta</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Proyecciones para mejores negociaciones</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>gestion completa del proceso de pago para cada
								asociado</span
							>
						</li>
					</ul>
				</div>

				<!-- Payments Module -->
				<div
					class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow"
				>
					<div class="text-center mb-6">
						<div
							class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"
						>
							<span class="text-3xl">💰</span>
						</div>
						<h3 class="text-xl font-bold text-gray-900">
							Gestión Automática de Pagos
						</h3>
					</div>
					<ul class="space-y-3">
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Cálculos automáticos sin errores</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Control completo de recaudos</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Historial transparente y justificado</span
							>
						</li>
					</ul>
				</div>
				<div
					class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow"
				>
					<div class="text-center mb-6">
						<div
							class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"
						>
							<span class="text-3xl">💰</span>
						</div>
						<h3 class="text-xl font-bold text-gray-900">
							Gestión de gastos
						</h3>
					</div>
					<ul class="space-y-3">
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Registro completo de cada egreso de la
								aosciacion</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Control cntrol completo de los recursos
								recaudados</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Historial transparente y justificado</span
							>
						</li>
					</ul>
				</div>

				<!-- Technical Assistance Module -->
				<div
					class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow"
				>
					<div class="text-center mb-6">
						<div
							class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
						>
							<span class="text-3xl">👨‍🌾</span>
						</div>
						<h3 class="text-xl font-bold text-gray-900">
							Asistencia Técnica 24/7
						</h3>
					</div>
					<ul class="space-y-3">
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Diagnósticos instantáneos con IA</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Recomendaciones personalizadas</span
							>
						</li>
						<li class="flex items-start">
							<span class="text-green-500 mr-3 mt-0.5">✓</span>
							<span class="text-gray-700"
								>Base de conocimiento compartida</span
							>
						</li>
					</ul>
				</div>
			</div>
		</Container>
	</Section>

	<!-- Results Section -->
	<Section class="py-16 bg-green-800 text-white">
		<Container>
			<div class="text-center mb-16">
				<h2 class="text-3xl lg:text-4xl font-bold mb-4">
					Resultados Medibles para tu Asociación
				</h2>
				<p class="text-xl text-green-100">
					Más de una simple herramienta, es una transformación
					completa
				</p>
			</div>

			<div class="grid md:grid-cols-4 gap-8">
				<div class="text-center">
					<div
						class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-4xl font-bold text-yellow-400"
							>30%</span
						>
					</div>
					<h3 class="font-bold text-lg mb-2">Ahorro en Costos</h3>
					<p class="text-green-100 text-sm">
						Reducción significativa en gastos operativos
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-4xl font-bold text-yellow-400"
							>80%</span
						>
					</div>
					<h3 class="font-bold text-lg mb-2">Menos Tiempo Admin</h3>
					<p class="text-green-100 text-sm">
						Automatización de tareas repetitivas
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-4xl font-bold text-yellow-400"
							>95%</span
						>
					</div>
					<h3 class="font-bold text-lg mb-2">Precisión en Pagos</h3>
					<p class="text-green-100 text-sm">
						Eliminación casi total de errores
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-20 h-20 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-4xl font-bold text-yellow-400"
							>24/7</span
						>
					</div>
					<h3 class="font-bold text-lg mb-2">Soporte Técnico</h3>
					<p class="text-green-100 text-sm">
						Asistencia disponible siempre
					</p>
				</div>
			</div>

			<!-- CTA Section -->
			<div class="text-center mt-16">
				<div
					class="bg-white/10 backdrop-blur rounded-2xl p-8 max-w-3xl mx-auto"
				>
					<h3 class="text-2xl font-bold mb-4">
						¿Listo para Transformar tu Asociación?
					</h3>
					<p class="text-green-100 mb-8">
						Únete a las asociaciones que ya están optimizando sus
						operaciones
					</p>

					<div
						class="flex flex-col sm:flex-row gap-4 justify-center mb-6"
					>
						<button
							id="btnWhatsApp"
							class:list={"bg-yellow-500 text-green-800 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transform hover:scale-105 transition-all shadow-lg"}
						>
							🎯 INICIAR PRUEBA GRATUITA
						</button>
						<Button
							href="/demo/form"
							class:list={"border-2 border-white text-white px-8 py-4 rounded-lg font-medium hover:bg-white hover:text-green-800 transition-colors"}
						>
							Agendar Demostración
						</Button>
					</div>

					<div class="text-sm text-green-100 mb-4">
						✅ 30 días gratis • ✅ Sin tarjeta de crédito • ✅
						Capacitación incluida
					</div>

					<div
						class="bg-red-500/20 border border-red-400/30 rounded-lg p-3"
					>
						<p class="text-sm font-medium">
							⚡ OFERTA ESPECIAL: Precio preferencial para las
							primeras 10 asociaciones
						</p>
					</div>
				</div>
			</div>
		</Container>
	</Section>

	<!-- Guarantees Section -->
	<Section class="py-16 bg-white">
		<Container>
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">
					Nuestras Garantías
				</h2>
				<p class="text-xl text-gray-600">
					Te acompañamos en cada paso de la implementación
				</p>
			</div>

			<div class="grid md:grid-cols-4 gap-8">
				<div class="text-center">
					<div
						class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-3xl">📱</span>
					</div>
					<h3 class="font-bold text-gray-900 mb-2">Fácil de Usar</h3>
					<p class="text-gray-600 text-sm">
						Interfaz intuitiva desde cualquier dispositivo
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-3xl">👨‍💻</span>
					</div>
					<h3 class="font-bold text-gray-900 mb-2">
						Soporte Completo
					</h3>
					<p class="text-gray-600 text-sm">
						Capacitación personalizada y acompañamiento
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
					>
						<span class="text-3xl">🔒</span>
					</div>
					<h3 class="font-bold text-gray-900 mb-2">Datos Seguros</h3>
					<p class="text-gray-600 text-sm">
						Respaldos automáticos y máxima seguridad
					</p>
				</div>

				<div class="text-center">
					<div
						class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"
