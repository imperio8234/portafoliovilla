		} as const;

		// Mensajes predefinidos
		const MESSAGES = {
			whatsappDemo: encodeURIComponent(
				"🚨 ¡Hola! Vengo de la página web y NECESITO URGENTE una solución para mi asociación.\n\n" +
					"Estamos perdiendo dinero por:\n" +
					"• Errores en pagos y recaudos\n" +
