			<script>
				// Configuración
				//@ts-nocheck
				const CONFIG = {
					whatsappNumber: "573205318658",
					phoneNumber: "+573205318658",
					companyEmail: "demo@tuempresa.com",
				} as const;

				// Mensajes predefinidos
				const MESSAGES = {
					whatsappDemo: encodeURIComponent(
						"¡Hola! Acabo de visitar su página web y me interesa conocer una solución para mi asociación.\n\n" +
							"Actualmente enfrentamos desafíos como:\n" +
							"• Errores en pagos y recaudos\n" +
							"• Falta de control en cultivos\n" +
							"• Necesidad de mayor transparencia\n\n" +
							"Me gustaría conocer más sobre el software y el Agrónomo IA que ofrecen. ¿Podemos agendar una demo personalizada?",
					),

					whatsappTrial: encodeURIComponent(
						"¡Hola! Me gustaría acceder a la prueba gratuita de 30 días del software para asociaciones.\n\n" +
							"He visto que ofrecen:\n" +
							"✅ Control automático de pagos\n" +
							"✅ Agrónomo Virtual con IA\n" +
							"✅ Gestión transparente\n\n" +
							"¿Podrían indicarme cómo comenzar?",
					),
				} as const;

				const btnWhatsApp = document.getElementById(
					"btnWhatsAppx",
				) as HTMLButtonElement;
				// Función para abrir WhatsApp
				const openWhatsApp = (message: string): void => {
					const url = `https://wa.me/${CONFIG.whatsappNumber}?text=${message}`;
					window.open(url, "_blank");
				};

				// Event Listeners - Sección de contacto
				btnWhatsApp?.addEventListener("click", () => {
					openWhatsApp(MESSAGES.whatsappTrial);
				});

				// Smooth scroll animations
				const observerOptions = {
					threshold: 0.1,
					rootMargin: "0px 0px -50px 0px",
				};

				const observer = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.style.opacity = "1";
							entry.target.style.transform = "translateY(0)";
						}
					});
				}, observerOptions);

				// Initialize sections for animation
				document.addEventListener("DOMContentLoaded", () => {
					document.querySelectorAll("section").forEach((section) => {
						section.style.opacity = "0";
						section.style.transform = "translateY(20px)";
						section.style.transition =
							"opacity 0.6s ease, transform 0.6s ease";
						observer.observe(section);
					});
				});

				// Button interactions
				document
					.querySelectorAll('button, a[role="button"]')
					.forEach((button) => {
						button.addEventListener("click", function (e) {
							this.style.transform = "scale(0.95)";
							setTimeout(() => {
								this.style.transform = "";
							}, 150);
						});
					});
			</script>
		</Container>
