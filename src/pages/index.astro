---
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Section from "~/components/Section.astro";
import Container from "~/components/Container.astro";
import Button from "~/components/Button.astro";
import Hero from "~/components/Hero.astro";
import Faq from "~/components/Faq.astro";
import Heading from "~/components/Heading.astro";
import WidgetSearch from "~/components/WidgetSearch.astro";
import Grid from "~/components/Grid.astro";
import GridItem from "~/components/GridItem.astro";
import ShowPosts from "~/components/ShowPosts.astro";
import Team from "~/components/Team.astro";
import Stats from "~/components/Stats.astro";

// Images
import ImageSoftwareMain from "~/assets/images/image3.png";
import ImageHeadingBackground from "~/assets/images/image2.png";
import ShowFeatures from "~/components/ShowFeatures.astro";
import ImageAutomation from "~/assets/images/pexels-leif-bergerson-99376750-9764731.webp";
import ImageAnalytics from "~/assets/images/pexels-zenzazione-2922140.webp";
---

<Layout
	pageTitle="Software para Asociaciones Agrarias y Automatización con IA"
	title="Software para asociaciones y servicios de automatizaciones con ia"
	description="Software especializado para asociaciones agrícolas que controla recolección de productos, pagos a productores, contabilidad y recaudos. Incluye servicios de automatización e inteligencia artificial para WhatsApp y redes sociales."
>	{/* Main Heading */}
	<Section class:list={"relative"}>
		<Image
			src={ImageHeadingBackground}
			alt="Software asociativo background"
			class:list={"absolute inset-0 w-full h-full object-cover"}
		/>
		<div class="absolute inset-0 w-full h-full object-cover bg-green-800/85"></div>
		<Container class:list={"relative z-10"}>
			<Heading class:list={"prose-invert max-w-5xl"}>
				<h1 slot="heading-title" class="mb-0 lg:text-7xl text-balance">
					Transformamos asociaciones agrarias con software especializado
				</h1>
				<p slot="heading-content" class="text-xl">
					Software diseñado específicamente para asociaciones agrícolas que necesitan controlar la 
					recolección de productos, pagos a productores, contabilidad y recaudos de asociados. 
					Además, revoluciona tu organización con servicios de automatización e inteligencia artificial.
				</p>
			</Heading>
			<div class="mt-8 flex flex-col sm:flex-row gap-4">
				<Button href="/demo/sociate" class:list={"bg-white text-green-800 hover:bg-green-50 text-lg px-8 py-4"}>Prueba el Software GRATIS</Button>
				<Button href="/services/automatizaciones" color="white-outline" class:list={"text-lg px-8 py-4"}>Servicios de IA</Button>
			</div>
		</Container>
	</Section>

	{/* Hero - Software Asociativo */}
	<Section>
		<Container>
			<Hero>
				<div slot="hero-left" class="prose lg:max-w-2xl">
					<div class="bg-green-100 text-green-800 px-4 py-2 rounded-full inline-block text-sm font-semibold mb-4">
						🚀 SOFTWARE ASOCIATIVO
					</div>
					<h2 class="text-3xl font-bold text-gray-900">¿Tu asociación agraria sigue llevando todo en papeles y Excel?</h2>
					<p class="text-gray-700 text-lg">
						<strong>Es hora de cambiar.</strong> Nuestro software especializado resuelve los problemas diarios que enfrentan 
						las asociaciones agrícolas: control caótico de productos, pagos atrasados, contabilidad desorganizada 
						y recaudos manuales que consumen tiempo valioso.
					</p>

					<div class="bg-red-50 border-l-4 border-red-400 p-4 my-6">
						<h4 class="text-red-800 font-semibold mb-2">¿Te suena familiar?</h4>
						<ul class="text-red-700 space-y-1 text-sm">
							<li>✗ Pérdida de productos por falta de control</li>
							<li>✗ Pagos atrasados que generan conflictos</li>
							<li>✗ Contabilidad desactualizada y errores constantes</li>
							<li>✗ Horas perdidas en tareas administrativas</li>
							<li>✗ Falta de transparencia con los asociados</li>
						</ul>
					</div>

					<div class="bg-green-50 border-l-4 border-green-400 p-4 mb-6">
						<h4 class="text-green-800 font-semibold mb-2">Con nuestro software:</h4>
						<ul class="text-green-700 space-y-1 text-sm">
							<li>✓ Control total de recolección y productos</li>
							<li>✓ Pagos automáticos y transparentes</li>
							<li>✓ Contabilidad actualizada en tiempo real</li>
							<li>✓ Ahorra 80% del tiempo administrativo</li>
							<li>✓ Transparencia total con tus asociados</li>
						</ul>
					</div>

					<Button href="/demo-software" class:list={"mt-6 bg-green-600 text-white text-lg px-8 py-4 hover:bg-green-700"}>
					 Quiero	Probar GRATIS 
					</Button>
					<p class="text-sm text-gray-600 mt-2">Sin compromiso • Sin tarjeta de crédito • Soporte incluido</p>
				</div>
				<div slot="hero-right">
					<Image src={ImageSoftwareMain} alt="Software asociativo dashboard" />
					<div class="mt-4 text-center">
						<div class="bg-white p-4 rounded-lg shadow-md">
							<p class="text-sm text-gray-600 mb-2">Diseñado con asociaciones para asociaciones</p>
							<div class="flex justify-center items-center space-x-4">
								<div class="text-center">
									<div class="text-2xl font-bold text-green-600">80%</div>
									<div class="text-xs text-gray-500">Menos tiempo</div>
								</div>
								<div class="text-center">
									<div class="text-2xl font-bold text-blue-600">95%</div>
									<div class="text-xs text-gray-500">Satisfacción</div>
								</div>
								<div class="text-center">
									<div class="text-2xl font-bold text-purple-600">24/7</div>
									<div class="text-xs text-gray-500">Soporte</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</Hero>
		</Container>
	</Section>

	{/* NUEVA SECCIÓN: Asistente Agrónomo IA - Coming Soon */}
	<Section class:list={"bg-gradient-to-br from-blue-600 via-purple-600 to-green-600 relative overflow-hidden"}>
		{/* Elementos decorativos de fondo */}
		<div class="absolute inset-0 opacity-10">
			<div class="absolute top-10 left-10 w-32 h-32 bg-white rounded-full blur-xl"></div>
			<div class="absolute bottom-10 right-10 w-48 h-48 bg-white rounded-full blur-xl"></div>
			<div class="absolute top-1/2 left-1/3 w-24 h-24 bg-white rounded-full blur-lg"></div>
		</div>

		<Container class:list={"relative z-10"}>
			{/* Badge de "Coming Soon" */}
			<div class="text-center mb-8">
				<div class="inline-flex items-center bg-white/20 backdrop-blur-sm rounded-full px-6 py-3 text-white border border-white/30">
					<div class="w-3 h-3 bg-yellow-400 rounded-full mr-3 animate-pulse"></div>
					<span class="font-semibold text-lg">🔬 PRÓXIMAMENTE - EN DESARROLLO</span>
				</div>
			</div>

			<Heading class:list={"prose-invert text-center mx-auto mb-12"}>
				<h2 slot="heading-title" class="text-4xl lg:text-6xl font-bold mb-6 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent">
					🤖 Asistente Agrónomo
				</h2>
				<h3 slot="heading-title" class="text-xl lg:text-4xl font-bold mb-6 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent">
					🤖 Evita perdidas economicas, y mejora tu produccion
				</h3
				<p slot="heading-content" class="text-xl text-blue-100 max-w-4xl mx-auto">
					Imagínate tener un ingeniero agrónomo experto disponible 24/7 dentro de tu software, 
					listo para resolver cualquier consulta técnica sobre tus cultivos, plagas, enfermedades y mejores prácticas agrícolas, .
				</p>
			</Heading>

			{/* Grid de características del asistente */}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
				<div class="bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20">
					<div class="text-5xl mb-4">🌱</div>
					<h3 class="text-2xl font-bold text-white mb-4">Consultas Técnicas Instantáneas</h3>
					<p class="text-blue-100 text-lg">
						Pregunta sobre fertilización, control de plagas, calendario de siembras, enfermedades 
						de cultivos y recibe respuestas expertas al instante.
					</p>
				</div>

				<div class="bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20">
					<div class="text-5xl mb-4">📊</div>
					<h3 class="text-2xl font-bold text-white mb-4">Análisis de Datos Agronómicos</h3>
					<p class="text-blue-100 text-lg">
						Analiza tus datos de producción y recibe recomendaciones personalizadas para 
						optimizar rendimientos y reducir costos.
					</p>
				</div>

				<div class="bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20">
					<div class="text-5xl mb-4">🔬</div>
					<h3 class="text-2xl font-bold text-white mb-4">Diagnóstico Visual</h3>
					<p class="text-blue-100 text-lg">
						Sube fotos de problemas en cultivos y recibe diagnósticos precisos con 
						recomendaciones de tratamiento inmediatas.
					</p>
				</div>

				<div class="bg-white/10 backdrop-blur-sm rounded-xl p-8 border border-white/20">
					<div class="text-5xl mb-4">🎯</div>
					<h3 class="text-2xl font-bold text-white mb-4">Recomendaciones Personalizadas</h3>
					<p class="text-blue-100 text-lg">
						Basado en tu ubicación, tipo de cultivo, historial y datos climáticos para 
						brindarte consejos específicos para tu región.
					</p>
				</div>
			</div>

			{/* Simulación de chat preview */}
			<div class="max-w-2xl mx-auto mb-12">
				<div class="bg-white/95 backdrop-blur rounded-2xl shadow-2xl p-6">
					<div class="flex items-center mb-4 pb-4 border-b border-gray-200">
						<div class="w-12 h-12 bg-gradient-to-r from-green-500 to-blue-500 rounded-full flex items-center justify-center">
							<span class="text-white text-xl">🤖</span>
						</div>
						<div class="ml-3">
							<div class="font-semibold text-gray-900">Agrónomo</div>
							<div class="text-sm text-green-600 flex items-center">
								<div class="w-2 h-2 bg-green-500 rounded-full mr-2"></div>
								En línea - Siempre disponible
							</div>
						</div>
					</div>

					<div class="space-y-4">
						<div class="flex">
							<div class="bg-gray-100 rounded-2xl px-4 py-3 max-w-xs">
								<p class="text-sm text-gray-800">Mi café tiene unas manchas amarillas en las hojas ¿qué puede ser?</p>
							</div>
						</div>

						<div class="flex justify-end">
							<div class="bg-gradient-to-r from-blue-500 to-green-500 text-white rounded-2xl px-4 py-3 max-w-sm">
								<p class="text-sm">Basándome en tu descripción y ubicación en Risaralda, podría ser roya del café. Te recomiendo:</p>
								<ul class="text-xs mt-2 space-y-1">
									<li>• Aplicar fungicida preventivo</li>
									<li>• Mejorar ventilación entre plantas</li>
									<li>• Monitorear humedad</li>
								</ul>
								<p class="text-xs mt-2 opacity-90">¿Puedes enviarme una foto para confirmar?</p>
							</div>
						</div>

						<div class="text-center">
							<div class="inline-flex items-center bg-gradient-to-r from-blue-500 to-purple-500 text-white rounded-full px-4 py-2 text-xs">
								<div class="w-2 h-2 bg-white rounded-full mr-2 animate-pulse"></div>
								Escribiendo respuesta...
							</div>
						</div>
					</div>
				</div>
			</div>

			{/* Call to action */}
			<div class="text-center">
				<div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 max-w-3xl mx-auto border border-white/20">
					<h3 class="text-3xl font-bold text-white mb-4">¡Sé el primero en probarlo!</h3>
					<p class="text-blue-100 text-lg mb-6">
						Estamos desarrollando esta increíble funcionalidad. Regístrate ahora y te notificaremos 
						cuando esté disponible. Los primeros usuarios tendrán acceso <strong>GRATIS</strong> por 3 meses.
					</p>

					<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
						<Button href="/early-access-agronomo" class="bg-white text-blue-600 font-bold text-lg px-8 py-4 hover:bg-blue-50">
							🎯 Acceso Anticipado GRATIS
						</Button>
						<Button href="/demo-software" color="white-outline" class="text-lg px-8 py-4">
							Ver Software Actual
						</Button>
					</div>

					<div class="mt-6 text-sm text-blue-200">
						<div class="flex items-center justify-center space-x-6">
							<span>✓ Sin costo adicional</span>
							<span>✓ Integrado al software</span>
							<span>✓ Disponible 24/7</span>
						</div>
					</div>

					{/* Contador de interesados (simulado) */}
					<div class="mt-8 p-4 bg-white/5 rounded-xl border border-white/10">
						<div class="text-center">
							<div class="text-3xl font-bold text-yellow-400 mb-2"></div>
							<div class="text-sm text-blue-200">las asociaciones ya se registraron para el acceso anticipado</div>
							<div class="mt-2 flex justify-center">
								<div class="flex -space-x-2">
									{/* Avatares simulados */}
									<div class="w-8 h-8 bg-green-500 rounded-full border-2 border-white flex items-center justify-center text-xs text-white">A</div>
									<div class="w-8 h-8 bg-blue-500 rounded-full border-2 border-white flex items-center justify-center text-xs text-white">M</div>
									<div class="w-8 h-8 bg-purple-500 rounded-full border-2 border-white flex items-center justify-center text-xs text-white">C</div>
									<div class="w-8 h-8 bg-orange-500 rounded-full border-2 border-white flex items-center justify-center text-xs text-white">+</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</Container>
	</Section>

		{/* Problemas vs Soluciones */}
	<Section class:list={"bg-gray-50"}>
		<Container>
			<Heading class:list={"text-center mx-auto mb-12"}>
				<h2 slot="heading-title" class="text-balance">De los problemas diarios a la solución definitiva</h2>
				<p slot="heading-content">
					Cada módulo de nuestro software está diseñado para resolver un problema específico de tu asociación
				</p>
			</Heading>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				{/* Problema 1 */}
				<div class="bg-red-50 p-6 rounded-xl border-l-4 border-red-400">
					<h3 class="text-red-800 font-bold text-xl mb-4">😰 PROBLEMA: Control de Productos</h3>
					<ul class="text-red-700 space-y-2 text-sm mb-4">
						<li>• No sabes exactamente qué productos han entregado los asociados</li>
						<li>• Pérdidas por productos no registrados o mal contabilizados</li>
						<li>• Confusión en las fechas y cantidades de entrega</li>
						<li>• Imposible hacer seguimiento del estado de los productos</li>
					</ul>
				</div>

				<div class="bg-green-50 p-6 rounded-xl border-l-4 border-green-400">
					<h3 class="text-green-800 font-bold text-xl mb-4">✅ SOLUCIÓN: Gestión de Recolección</h3>
					<ul class="text-green-700 space-y-2 text-sm mb-4">
						<li>• Registro automático de cada entrega con fecha y hora</li>
						<li>• Control total de inventarios en tiempo real</li>
						<li>• Trazabilidad completa desde productor hasta venta</li>
						<li>• Reportes detallados por asociado y período</li>
					</ul>
					<Button href="/modulos/recoleccion"  class="bg-green-600 text-white">Ver módulo</Button>
				</div>

				{/* Problema 2 */}
				<div class="bg-red-50 p-6 rounded-xl border-l-4 border-red-400">
					<h3 class="text-red-800 font-bold text-xl mb-4">💸 PROBLEMA: Pagos Desorganizados</h3>
					<ul class="text-red-700 space-y-2 text-sm mb-4">
						<li>• Cálculos manuales propensos a errores</li>
						<li>• Retrasos en pagos que generan desconfianza</li>
						<li>• Falta de transparencia en los montos</li>
						<li>• Tiempo excesivo en procesos de pago</li>
					</ul>
				</div>

				<div class="bg-green-50 p-6 rounded-xl border-l-4 border-green-400">
					<h3 class="text-green-800 font-bold text-xl mb-4">💰 SOLUCIÓN: Pagos Automáticos</h3>
					<ul class="text-green-700 space-y-2 text-sm mb-4">
						<li>• Cálculo automático basado en entregas registradas</li>
						<li>• Pagos programados y puntuales</li>
						<li>• Transparencia total con recibos detallados</li>
						<li>• Integración con bancos para transferencias directas</li>
					</ul>
					<Button href="/modulos/pagos" class="bg-green-600 text-white">Ver módulo</Button>
				</div>

				{/* Problema 3 */}
				<div class="bg-red-50 p-6 rounded-xl border-l-4 border-red-400">
					<h3 class="text-red-800 font-bold text-xl mb-4">📊 PROBLEMA: Contabilidad Caótica</h3>
					<ul class="text-red-700 space-y-2 text-sm mb-4">
						<li>• Libros contables desactualizados</li>
						<li>• Errores frecuentes en cálculos</li>
						<li>• Imposible generar reportes rápidamente</li>
						<li>• Cumplimiento fiscal complicado</li>
					</ul>
				</div>

				<div class="bg-green-50 p-6 rounded-xl border-l-4 border-green-400">
					<h3 class="text-green-800 font-bold text-xl mb-4">📈 SOLUCIÓN: Contabilidad Automática</h3>
					<ul class="text-green-700 space-y-2 text-sm mb-4">
						<li>• Contabilidad actualizada automáticamente</li>
						<li>• Reportes financieros instantáneos</li>
						<li>• Cumplimiento fiscal automatizado</li>
						<li>• Análisis de rentabilidad en tiempo real</li>
					</ul>
					<Button href="/modulos/contabilidad"  class="bg-green-600 text-white">Ver módulo</Button>
				</div>

				{/* Problema 4 */}
				<div class="bg-red-50 p-6 rounded-xl border-l-4 border-red-400">
					<h3 class="text-red-800 font-bold text-xl mb-4">👥 PROBLEMA: Gestión de Asociados</h3>
					<ul class="text-red-700 space-y-2 text-sm mb-4">
						<li>• Recaudos manuales que consumen tiempo</li>
						<li>• Falta de control sobre cuotas y aportes</li>
						<li>• Comunicación ineficiente con los miembros</li>
						<li>• Registros desorganizados de asociados</li>
					</ul>
				</div>

				<div class="bg-green-50 p-6 rounded-xl border-l-4 border-green-400">
					<h3 class="text-green-800 font-bold text-xl mb-4">🤝 SOLUCIÓN: Gestión Integral</h3>
					<ul class="text-green-700 space-y-2 text-sm mb-4">
						<li>• Recaudos automatizados con recordatorios</li>
						<li>• Control total de cuotas y aportes</li>
						<li>• Comunicación directa vía WhatsApp/SMS</li>
						<li>• Base de datos completa de asociados</li>
					</ul>
					<Button href="/modulos/asociados"  class="bg-green-600 text-white">Ver módulo</Button>
				</div>
			</div>

			<div class="text-center mt-12">
				<div class="bg-white p-8 rounded-xl shadow-lg max-w-2xl mx-auto">
					<h3 class="text-2xl font-bold text-gray-900 mb-4">¿Listo para dejar atrás estos problemas?</h3>
					<p class="text-gray-600 mb-6">
						Comienza a transformar tu asociacion su gestión. Es tu turno.
					</p>
					<Button href="/demo-software" class="bg-green-600 text-white text-lg px-8 py-4 hover:bg-green-700">
						Comenzar Prueba Gratuita
					</Button>
				</div>
			</div>
		</Container>
	</Section>

	

	{/* Software Features 
	<Section class:list={"bg-blue-50"}>
		<Container>
			<Heading>
				<h2 slot="heading-title" class="mb-0">Módulos del Software Asociativo</h2>
				<p slot="heading-content">
					Cada módulo está diseñado para resolver problemas específicos de las asociaciones agrarias, 
					trabajando juntos como un sistema integral.
				</p>
			</Heading>

			<ShowFeatures modules={["gestion-productos", "pagos-automatizados", "contabilidad-inteligente"]} />
		</Container>
	</Section>*/}
	{/* Pricing Section */}
	<Section class:list={"bg-gray-50"} id="precios">
		<Container>
			<Heading class:list={"text-center mx-auto mb-12"}>
				<h2 slot="heading-title" class="text-balance">Planes de Precios Flexibles para Tu Asociación</h2>
				<p slot="heading-content">
					Elige el plan que mejor se adapte a las necesidades y el tamaño de tu asociación agraria.
					Comienza gratis y escala a medida que creces.
				</p>
			</Heading>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{/* Plan Gratis */}
				<div class="bg-white p-6 rounded-xl shadow-lg flex flex-col justify-between border-t-4 border-green-400">
					<div>
						<h3 class="text-2xl font-bold text-gray-900 mb-2">Gratis</h3>
						<p class="text-gray-600 mb-4">Ideal para comenzar y probar el software.</p>
						<p class="text-4xl font-bold text-green-700 mb-4">$0 <span class="text-lg text-gray-500">/ mes</span></p>
						<ul class="text-gray-700 space-y-2 text-sm mb-6">
							<li>✅ 1 administrador + 5 asociados</li>
							<li>✅ Módulo de asociados (básico)</li>
							<li>✅ Pagos y gastos básicos</li>
							<li>✅ Soporte por email</li>
						</ul>
					</div>
					<Button href="/demo-software" class="w-full bg-green-600 text-white hover:bg-green-700">Comenzar Gratis</Button>
				</div>

				{/* Plan Básico */}
